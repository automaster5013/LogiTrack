www.logitrack.kr {
  encode zstd gzip
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    -Server
    -Via
    -X-Powered-By
    -X-Nextjs-*
  }
  reverse_proxy web:3000
  log {
    output stdout
    format json
  }
}
