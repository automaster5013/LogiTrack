POSTGRES_DB=logitrack
POSTGRES_USER=logitrack
POSTGRES_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Production web image: NEXT_PUBLIC_API_URL=/backend
# AUTH_REQUIRED=true
# COGNITO_AUTHORIZATION_BASE_URL=https://auth.logitrack.kr
# COGNITO_ISSUER_URI=https://cognito-idp.ap-northeast-2.amazonaws.com/<user-pool-id>
# COGNITO_CLIENT_ID=<public-app-client-id>
# OIDC_REDIRECT_URI=https://www.logitrack.kr/auth/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=https://www.logitrack.kr/login
# API: SECURITY_ENABLED=true, SECURITY_CLIENT_ID=<same-public-app-client-id>
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=2.5
ROUTING_CACHE_TTL_SECONDS=300
TRACING_SAMPLING_PROBABILITY=1.0
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
